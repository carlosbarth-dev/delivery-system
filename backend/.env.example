# ==========================================
# Backend Environment Variables
# ==========================================
# Copy to .env and fill with actual values

# Database Configuration
# SQLite (MVP): delivery.db (arquivo local)
# MySQL (v0.2.0): mysql+pymysql://user:pass@localhost:3306/delivery_db
DATABASE_URL=sqlite:///./delivery.db

# Application
DEBUG=True
SECRET_KEY=dev-secret-change-me-in-production

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# CORS (update for production)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
